# Variaveis obrigatorias em producao (Neon + Vercel Marketplace)
# A integracao do Neon normalmente cria DATABASE_URL automaticamente.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
BLOB_READ_WRITE_TOKEN=seu-token-do-vercel-blob
FDP_AUTH_SECRET=gere-um-segredo-longo-e-aleatorio

# HMAC dedicado para CPF e outros identificadores pessoais.
# Sem ele o cadastro de pessoas cai no FDP_AUTH_SECRET; defina um proprio.
FDP_PII_HASH_SECRET=gere-outro-segredo-longo-e-aleatorio

# Cofre das credenciais de integracao. SEM ISTO NENHUMA CREDENCIAL E SALVA:
# a API responde 503 VAULT_NOT_CONFIGURED em "Guardar credencial".
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FDP_INTEGRATION_VAULT_KEY=chave-aes-256-em-base64
FDP_INTEGRATION_VAULT_KEY_VERSION=1
# Rotacao sem indisponibilidade: JSON {"1":"base64","2":"base64"} no lugar da chave unica.
FDP_INTEGRATION_VAULT_KEYS=

# Segredo do executor assincrono de integracoes e webhooks.
# Sem ele /api/integrations/worker e /api/webhooks/worker recusam a chamada.
FDP_INTEGRATION_WORKER_SECRET=gere-um-segredo-para-o-executor

# Segredo que a Vercel Cron envia em Authorization: Bearer ao chamar
# /api/cron/integrations a cada 5 minutos. SEM ELE A FILA NAO ANDA:
# sincronizar enfileira e nada executa. Pode ser o mesmo valor do executor.
CRON_SECRET=gere-um-segredo-com-32-caracteres-ou-mais

# Opcionais: webhooks e sincronizacoes externas
FDP_EMAIL_TOKEN=
FDP_WHATSAPP_TOKEN=
FDP_TEAMS_TOKEN=
FDP_DRIVE_TOKEN=
FDP_ONEDRIVE_TOKEN=
FDP_ERP_TOKEN=

# Microsoft Graph (Teams e OneDrive; use as tres variaveis juntas)
FDP_MICROSOFT_CLIENT_ID=
FDP_MICROSOFT_TENANT_ID=
FDP_MICROSOFT_CLIENT_SECRET=
FDP_TEAMS_ENDPOINT=https://graph.microsoft.com/v1.0/teams/TEAM_ID/channels/CHANNEL_ID/messages
FDP_ONEDRIVE_ENDPOINT=https://graph.microsoft.com/v1.0/drives/DRIVE_ID/root/children
# Hosts adicionais, aprovados pela equipe de infraestrutura (separados por vírgula)
FDP_INTEGRATION_ALLOWED_HOSTS=

# Sankhya Gateway (OAuth2 Client Credentials; X-Token vem do Sankhya Om)
FDP_SANKHYA_BASE_URL=https://api.sankhya.com.br
FDP_SANKHYA_CLIENT_ID=
FDP_SANKHYA_CLIENT_SECRET=
FDP_SANKHYA_X_TOKEN=
FDP_SANKHYA_REQUEST_BODY=
FDP_SANKHYA_METRIC_FIELD_MAP=

# Segredos dos webhooks de entrada (email, WhatsApp e Teams)
FDP_EMAIL_WEBHOOK_SECRET=
FDP_WHATSAPP_WEBHOOK_SECRET=
FDP_TEAMS_WEBHOOK_SECRET=

# Recomendado quando houver mais de um workspace ativo no mesmo canal.
# Cada valor é um JSON workspaceId -> segredo com pelo menos 24 caracteres.
FDP_EMAIL_WEBHOOK_SECRETS={}
FDP_WHATSAPP_WEBHOOK_SECRETS={}
FDP_TEAMS_WEBHOOK_SECRETS={}
