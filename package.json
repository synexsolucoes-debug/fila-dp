{
  "name": "fila-dp-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "node scripts/deploy-migrate.mjs && next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test \"tests/*.test.mts\" \"tests/*.test.mjs\"",
    "test:sankhya": "node --experimental-strip-types --test tests/sankhya-browser-connector.test.mts",
    "test:acceptance": "node --experimental-strip-types --test tests/final-acceptance.test.mts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.mjs",
    "db:status": "node --experimental-strip-types scripts/migration-status.mjs",
    "schema:manifest": "node scripts/generate-schema-manifest.mjs",
    "smoke": "node scripts/smoke-http.mjs",
    "browser-check": "node scripts/browser-check.mjs",
    "journey-check": "node scripts/journey-check.mjs",
    "interface-check": "node scripts/interface-consistency.mjs",
    "a11y-check": "node scripts/a11y-check.mjs",
    "tangerino:fixtures": "node --experimental-strip-types scripts/tangerino-fixture-check.mjs",
    "verify:isolation": "node --experimental-strip-types scripts/verify-tenant-isolation.mjs",
    "verify:backup": "node scripts/verify-backup-policy.mjs",
    "verify:sql": "node --experimental-strip-types scripts/verify-inline-sql.mts",
    "neon-bridge": "node scripts/neon-http-bridge.mjs",
    "db:rehearse-phase2": "node scripts/rehearse-phase2-db.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:baseline": "node scripts/migrate.mjs --baseline-existing",
    "release:verify-source": "node scripts/verify-release-source.mjs",
    "ci": "npm run lint && npm run typecheck && npm run db:check && npm run test:sankhya && npm run test:acceptance && npm test && npm run build",
    "db:rehearse-payments": "node scripts/rehearse-payments-db.mjs",
    "db:rehearse": "node scripts/rehearse-payments-db.mjs",
    "db:rehearse-restore": "node scripts/rehearse-backup-restore.mjs",
    "db:rehearse-statement": "node --experimental-strip-types scripts/rehearse-contractor-statement.mjs",
    "db:rehearse-closing": "node --experimental-strip-types scripts/rehearse-contractor-closing.mjs",
    "db:rehearse-invoices": "node --experimental-strip-types scripts/rehearse-contractor-invoices.mjs",
    "db:rehearse-portal": "node --experimental-strip-types scripts/rehearse-contractor-invoice-portal.mjs",
    "db:rehearse-admission-sheet": "node --experimental-strip-types scripts/rehearse-admission-sheet.mjs",
    "db:rehearse-admission-sheet-photo-ocr": "node --experimental-strip-types scripts/rehearse-admission-sheet-photo-ocr.mjs",
    "db:rehearse-events": "node scripts/rehearse-integration-events.mjs",
    "worker:sankhya": "tsx worker/sankhya/index.ts",
    "worker:sankhya:once": "tsx worker/sankhya/once.ts",
    "worker:tangerino:once": "tsx worker/tangerino/once.ts",
    "worker:tangerino:windows": "node --env-file=.env.tangerino-worker.local --import tsx worker/tangerino/windows.ts",
    "worker:sankhya:check": "node scripts/check-sankhya-worker-env.mjs",
    "og:generate": "node scripts/generate-og-image.mjs",
    "db:rehearse-work": "node --experimental-strip-types scripts/rehearse-work-items.mjs",
    "db:rehearse-concurrency": "node --experimental-strip-types scripts/rehearse-concurrency.mjs",
    "db:rehearse-scheduler": "node scripts/rehearse-scheduler.mjs",
    "db:measure-work": "node --experimental-strip-types scripts/measure-work-center.mjs",
    "tangerino:diagnostico": "node --env-file-if-exists=.env.tangerino-worker.local --import tsx scripts/windows/diagnosticar-tangerino.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.74",
    "bpmn-js": "18.22.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stripe": "^22.4.0",
    "tsx": "^4.23.12",
    "unpdf": "^1.8.1",
    "unzipper": "^0.10.14",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bpmn-moddle": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "pg": "^8.23.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "zod": "^4.6.6",
    "uuid": "^11.1.1"
  },
  "type": "module"
}
