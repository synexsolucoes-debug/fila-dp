# Banco PostgreSQL/Neon. Nunca use a conexão de produção no Preview.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Sessão da aplicação; use um valor aleatório com no mínimo 32 bytes.
FDP_AUTH_SECRET=

# Proteção de tarefas agendadas e credenciais OAuth.
CRON_SECRET=
FDP_INTEGRATION_ENCRYPTION_KEY=
FDP_PUBLIC_URL=http://localhost:3000

# E-mail transacional (Resend).
RESEND_API_KEY=
FDP_EMAIL_FROM=Fila DP <onboarding@resend.dev>

# OAuth dos calendários.
FDP_GOOGLE_CALENDAR_CLIENT_ID=
FDP_GOOGLE_CALENDAR_CLIENT_SECRET=
FDP_MICROSOFT_CALENDAR_CLIENT_ID=
FDP_MICROSOFT_CALENDAR_CLIENT_SECRET=
FDP_MICROSOFT_TENANT_ID=

# WhatsApp Cloud API e análise opcional de anexos.
FDP_WHATSAPP_VERIFY_TOKEN=
FDP_WHATSAPP_APP_SECRET=
FDP_ANTIVIRUS_ENDPOINT=
FDP_ANTIVIRUS_TOKEN=
FDP_REQUIRE_ANTIVIRUS=false

# Entrada e sincronização multicanal. Tokens ficam somente no servidor.
FDP_EMAIL_TOKEN=
FDP_WHATSAPP_TOKEN=
FDP_TEAMS_TOKEN=
FDP_DRIVE_TOKEN=
FDP_ONEDRIVE_TOKEN=
FDP_ERP_TOKEN=
FDP_EMAIL_ENDPOINT=
FDP_TEAMS_ENDPOINT=
FDP_ONEDRIVE_ENDPOINT=
FDP_ERP_ENDPOINT=
FDP_EMAIL_WEBHOOK_SECRET=
FDP_WHATSAPP_WEBHOOK_SECRET=
FDP_TEAMS_WEBHOOK_SECRET=
FDP_EMAIL_WEBHOOK_SECRETS={}
FDP_WHATSAPP_WEBHOOK_SECRETS={}
FDP_TEAMS_WEBHOOK_SECRETS={}
FDP_INTEGRATION_ALLOWED_HOSTS=

# Microsoft Graph (Teams/OneDrive) e Sankhya Gateway.
FDP_MICROSOFT_CLIENT_ID=
FDP_MICROSOFT_CLIENT_SECRET=
FDP_SANKHYA_BASE_URL=https://api.sankhya.com.br
FDP_SANKHYA_CLIENT_ID=
FDP_SANKHYA_CLIENT_SECRET=
FDP_SANKHYA_X_TOKEN=
FDP_SANKHYA_REQUEST_BODY=
FDP_SANKHYA_METRIC_FIELD_MAP=

# Armazenamento privado de anexos da Vercel.
BLOB_READ_WRITE_TOKEN=

# Flags separadas por vírgula. Todas ficam desligadas por padrão.
FDP_FEATURE_FLAGS=
FDP_ALLOW_SENSITIVE_FEATURES=false
