# Banco PostgreSQL/Neon. Nunca use a conexão de produção no Preview.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Sessão da aplicação; use um valor aleatório com no mínimo 32 bytes.
FDP_AUTH_SECRET=

# HMAC separado para CPF e outros identificadores pessoais (mínimo 32 bytes).
FDP_PII_HASH_SECRET=

# Cofre por workspace: chave AES-256 em base64 (32 bytes) e segredo do executor assíncrono.
# Para rotação sem indisponibilidade, use FDP_INTEGRATION_VAULT_KEYS como JSON {"1":"base64","2":"base64"}.
FDP_INTEGRATION_VAULT_KEY=
FDP_INTEGRATION_VAULT_KEY_VERSION=1
FDP_INTEGRATION_VAULT_KEYS=
FDP_INTEGRATION_WORKER_SECRET=

# Armazenamento privado de anexos da Vercel.
BLOB_READ_WRITE_TOKEN=

# Flags separadas por vírgula. Todas ficam desligadas por padrão.
FDP_FEATURE_FLAGS=
FDP_ALLOW_SENSITIVE_FEATURES=false
