# Banco PostgreSQL/Neon. Nunca use a conexão de produção no Preview.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Sessão da aplicação; use um valor aleatório com no mínimo 32 bytes.
FDP_AUTH_SECRET=

# HMAC separado para CPF e outros identificadores pessoais (mínimo 32 bytes).
FDP_PII_HASH_SECRET=

# Cofre por workspace: chave AES-256 em base64 (32 bytes) e segredo do executor assíncrono.
# Para rotação sem indisponibilidade, use FDP_INTEGRATION_VAULT_KEYS como JSON {"1":"base64","2":"base64"}.
FDP_INTEGRATION_VAULT_KEY=
FDP_INTEGRATION_VAULT_KEY_VERSION=1
FDP_INTEGRATION_VAULT_KEYS=
FDP_INTEGRATION_WORKER_SECRET=

# Sankhya Browser Connector. Hosts separados por vírgula; curingas apenas no subdomínio.
FDP_SANKHYA_BROWSER_ALLOWED_HOSTS=*.sankhya.com.br
FDP_SANKHYA_BROWSER_ENDPOINT=
FDP_SANKHYA_WORKER_POLL_MS=5000
FDP_SANKHYA_WORKER_CONCURRENCY=3

# SaaS e cobrança. Cadastro público permanece desligado até decisão operacional explícita.
FDP_ALLOW_SELF_SIGNUP=false
FDP_PLATFORM_ADMIN_EMAILS=
FDP_APP_URL=https://app.exemplo.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Armazenamento privado de anexos da Vercel.
BLOB_READ_WRITE_TOKEN=

# Flags separadas por vírgula. Todas ficam desligadas por padrão.
FDP_FEATURE_FLAGS=
FDP_ALLOW_SENSITIVE_FEATURES=false

# HMAC das chaves da API pública (/api/v1). Sem ela, cai em FDP_AUTH_SECRET.
FDP_API_KEY_SECRET=

# Assistente do painel. Sem estas variáveis o assistente não some da tela: ele
# diz que não está configurado. Não há chave embutida no produto.
# Provedores aceitos: anthropic | openai.
FDP_ASSISTANT_PROVIDER=
FDP_ASSISTANT_API_KEY=
FDP_ASSISTANT_MODEL=
FDP_ASSISTANT_BASE_URL=
FDP_ASSISTANT_MAX_TOKENS=900
