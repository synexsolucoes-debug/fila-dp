# Copie para .env.tangerino-worker.local. Nunca versione o arquivo local.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Use exatamente o cofre do Agente Tangerino configurado no deployment.
# Para rotação, prefira o mapa de versões em FDP_TANGERINO_VAULT_KEYS.
FDP_TANGERINO_VAULT_KEY=
FDP_TANGERINO_VAULT_KEY_VERSION=1
FDP_TANGERINO_VAULT_KEYS=

# O mesmo valor deve existir no deployment para impedir o disparo concorrente
# do GitHub Actions. No processo local ele também documenta o modo em operação.
FDP_TANGERINO_WORKER_MODE=persistent
TANGERINO_BROWSER_AGENT_ENABLED=true
TANGERINO_BROWSER_CONCURRENCY=1
TANGERINO_BROWSER_TIMEOUT_MS=300000
FDP_TANGERINO_WORKER_POLL_MS=5000

# Diretório fora do repositório. Ele contém cookies autenticados e deve ficar
# acessível apenas à conta Windows dedicada ao worker.
FDP_TANGERINO_PROFILE_ROOT=C:\ProgramData\Vinculato\TangerinoProfiles
FDP_TANGERINO_INTERACTIVE_AUTH=true
FDP_TANGERINO_INTERACTIVE_AUTH_TIMEOUT_MS=600000

# Hosts oficiais adicionais, separados por vírgula, somente se o login real
# redirecionar para outro subdomínio legítimo do Tangerino/Sólides.
FDP_TANGERINO_BROWSER_ALLOWED_HOSTS=
FDP_TANGERINO_CHROMIUM_SANDBOX=false


